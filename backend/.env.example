# Obtain a free key from NASA FIRMS. Never commit the real key.
FIRMS_MAP_KEY=replace_me
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# Backend abuse controls (process-local; use a shared gateway/Redis limiter
# before running multiple backend instances).
FIREPULSE_RATE_LIMIT_PER_MINUTE=120
FIREPULSE_MAX_BBOX_DEGREE_AREA=5000
FIREPULSE_MAX_UPSTREAM_CONCURRENCY=4

# Optional comma-separated browser origins. Leave empty for Android/native-only.
FIREPULSE_CORS_ORIGINS=
